# ── LogSage AI — Environment Configuration ───────────────────────────────────
# Copy to .env and fill in values

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-32-char-secret-key
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://logsage:logsage_secret@localhost:5432/logsage
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# AI (required for RCA and analysis features)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db

# Processing
CLUSTERING_THRESHOLD=0.75
ANOMALY_WINDOW_SECONDS=300

# Alerts
ALERT_REDIS_FAILURE_THRESHOLD=5
ALERT_RECONNECT_STORM_THRESHOLD=10
ALERT_QUEUE_SIZE_THRESHOLD=1000

# CORS
CORS_ORIGINS=["http://localhost:3000"]
